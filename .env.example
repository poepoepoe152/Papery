# Copy this file to ".env" to access Papery from a phone / another device.
#
#   cp .env.example .env
#
# Set HOST_IP to your computer's LAN IP address (the machine running Docker),
# then run: docker compose up --build
#
# Find your LAN IP:
#   macOS:    ipconfig getifaddr en0
#   Windows:  ipconfig   (look for "IPv4 Address")
#   Linux:    hostname -I
#
# Leave this unset (or delete .env) to run on localhost only.

HOST_IP=192.168.1.45
