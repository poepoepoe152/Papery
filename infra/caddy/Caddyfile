# Papery reverse proxy with automatic HTTPS (Let's Encrypt).
# Caddy obtains and renews certificates for PUBLIC_DOMAIN automatically.
{$PUBLIC_DOMAIN} {
	encode gzip

	# API + health -> FastAPI backend
	handle /api/* {
		reverse_proxy backend:8000
	}
	handle /health {
		reverse_proxy backend:8000
	}

	# Everything else -> Next.js frontend
	handle {
		reverse_proxy frontend:3000
	}
}
